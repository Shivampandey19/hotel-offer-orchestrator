{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel Offer Orchestrator backend assessment",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@temporalio/client": "^1.13.0",
    "@temporalio/worker": "^1.13.0",
    "@temporalio/workflow": "^1.13.0",
    "axios": "^1.8.4",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
